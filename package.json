{
  "name": "cutepet",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"docs/**/*.md\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build && ng build --configuration development",
    "serve:ssr": "NG_ALLOWED_HOSTS=localhost node dist/cutepet/server/server.mjs",
    "db:types": "pnpm dlx supabase gen types typescript --local --schema public > src/app/core/supabase/database.types.ts",
    "db:test:concurrency": "bash supabase/tests/concurrency/double-booking.sh",
    "db:seed:images": "bash supabase/seed/upload-images.sh"
  },
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.4",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
